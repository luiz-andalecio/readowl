# Modelo do ambiente de produção. Copie para um arquivo fora do repositório e use com:
#   docker compose -f infra/compose.yaml --env-file <arquivo> up -d
# Em homologação não precisa dele: infra/homolog.sh gera o próprio arquivo, com senhas aleatórias.

# Imagem imutável, identificada pelo commit. Nunca use latest: é ela que permite voltar à versão anterior.
READOWL_IMAGE=

SERVER_NAME=
APP_PUBLIC_URL=
# Pasta com fullchain.pem e privkey.pem, legíveis pelo usuário 101 do contêiner do NGINX.
TLS_CERT_DIR=
HTTP_PORT=80
HTTPS_PORT=443

# Superusuário do contêiner do PostgreSQL. A aplicação não o usa.
POSTGRES_PASSWORD=

DB_NAME=readowl
# Só com o banco neste servidor e na rede interna do Compose. Com o banco em outro host: verify-full.
DB_SSL_MODE=disable
# Obrigatório com verify-full: caminho, dentro do contêiner, do certificado da autoridade do banco.
DB_SSL_ROOT_CERT=
# Lê e escreve, mas não altera o schema nem apaga a auditoria.
DB_USER=readowl_app
DB_PASSWORD=
# Dono do schema. Só o serviço migrate o conhece.
DB_MIGRATION_USER=readowl_migrator
DB_MIGRATION_PASSWORD=

MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Armazenamento compatível com S3, para as fotos de perfil. Sem S3_BUCKET, o envio de fotos responde 503.
# S3_ENDPOINT fica vazio na AWS. S3_PUBLIC_URL é o endereço público do bucket ou da CDN.
# No Cloudflare R2: S3_ENDPOINT=https://<id da conta>.r2.cloudflarestorage.com e S3_REGION=auto, com um domínio próprio em S3_PUBLIC_URL.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Sem o ID, o login com Google fica desativado, e nenhuma conta de moderação ou administração consegue entrar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
