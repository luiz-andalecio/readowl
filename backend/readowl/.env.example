# Copie para .env (nao versionado). Lido pelos perfis dev e test.

# Aplicacao (perfil dev). DB_HOST, DB_PORT e DB_NAME tem padrao em application-dev.properties.
DB_USER=readowl
DB_PASSWORD=

# Login com Google (opcional). Sem GOOGLE_CLIENT_ID, a aplicacao sobe com o login do Google desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Testes de integracao. Com READOWL_TEST_DB_URL definida, os testes usam este banco;
# sem ela, usam Testcontainers (exige Docker).
# ATENCAO: o schema deste banco e apagado a cada execucao. O nome precisa terminar em _test.
READOWL_TEST_DB_URL=jdbc:postgresql://localhost:5432/readowl_test
READOWL_TEST_DB_USER=readowl
READOWL_TEST_DB_PASSWORD=
